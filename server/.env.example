# ==============================================================================
# HIREFLOW ATS - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Environment (development | production | test)
NODE_ENV=production
PORT=5001

# Database Configuration
# SQLite (Local Dev): file:./dev.db
# PostgreSQL (Production): postgresql://USER:PASSWORD@HOST:5432/hireflow?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hireflow?schema=public"

# Authentication & JWT Secrets (USE STRONG RANDOM CRYPTOGRAPHIC STRINGS IN PRODUCTION)
JWT_SECRET="replace-with-minimum-32-character-random-hex-secret-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="replace-with-minimum-32-character-random-refresh-secret-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS & Base URLs
CLIENT_URL="https://hireflow.example.com"
SERVER_URL="https://api.hireflow.example.com"
CORS_ORIGIN="https://hireflow.example.com"

# Resume Storage Configuration (local | s3)
STORAGE_TYPE="s3"
UPLOAD_DIR="./uploads"

# AWS S3 Storage Credentials (Required when STORAGE_TYPE=s3)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="your-production-hireflow-resumes-bucket"
