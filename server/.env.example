# ==============================================================================
# HIREFLOW ATS - BACKEND ENVIRONMENT CONFIGURATION (POSTGRESQL & VERCEL)
# ==============================================================================

# Environment (development | production | test)
NODE_ENV=production
PORT=5001

# Database Configuration (Neon Serverless PostgreSQL)
# Pooled connection string (used by application runtime for connection reuse):
DATABASE_URL="postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/neondb?sslmode=require"
# Unpooled / Direct connection string (used by Prisma migrations for DDL session locks):
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[endpoint-id].[region].aws.neon.tech/neondb?sslmode=require"

# Authentication & JWT Secrets (USE STRONG RANDOM CRYPTOGRAPHIC STRINGS IN PRODUCTION)
JWT_ACCESS_SECRET="replace-with-minimum-32-character-random-hex-secret-in-production"
JWT_SECRET="replace-with-minimum-32-character-random-hex-secret-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="replace-with-minimum-32-character-random-refresh-secret-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS & Base URLs
CLIENT_URL="https://hireflow-client.vercel.app"
SERVER_URL="https://hireflow-api.vercel.app"
CORS_ORIGIN="https://hireflow-client.vercel.app"

# Resume Storage Configuration (s3 for production / local for offline testing)
STORAGE_TYPE="s3"
UPLOAD_DIR="./uploads"

# AWS S3 Storage Credentials (Required for Vercel & Production)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="your-production-hireflow-resumes-bucket"
