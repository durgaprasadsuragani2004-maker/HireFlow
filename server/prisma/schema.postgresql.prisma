// PostgreSQL Prisma schema for HireFlow Production ATS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  RECRUITER
  APPLICANT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ApplicationStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ExperienceLevel {
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR
  LEAD
  EXECUTIVE
}

enum InterviewType {
  TECHNICAL
  HR
  MANAGERIAL
  BEHAVIORAL
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum NotificationType {
  APPLICATION_STATUS
  INTERVIEW_SCHEDULED
  NEW_APPLICATION
  SYSTEM
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  role             Role              @default(APPLICANT)
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  recruiterProfile RecruiterProfile?
  applicantProfile ApplicantProfile?
  notifications    Notification[]
  auditLogs        AuditLog[]
  stageChanges     ApplicationStageHistory[]
  scheduledInterviews Interview[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Company {
  id           String             @id @default(uuid())
  name         String             @unique
  logo         String?
  description  String?
  website      String?
  industry     String?
  location     String?
  companySize  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  recruiters   RecruiterProfile[]
  jobs         Job[]

  @@index([name])
}

model RecruiterProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  companyId  String
  title      String?
  department String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs       Job[]

  @@index([userId])
  @@index([companyId])
}

model ApplicantProfile {
  id             String           @id @default(uuid())
  userId         String           @unique
  fullName       String
  phone          String?
  location       String?
  headline       String?
  summary        String?
  linkedinUrl    String?
  githubUrl      String?
  portfolioUrl   String?
  resumeUrl      String?
  resumeFileName String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         ApplicantSkill[]
  experience     Experience[]
  education      Education[]
  applications   Application[]

  @@index([userId])
  @@index([fullName])
}

model ApplicantSkill {
  id                 String           @id @default(uuid())
  applicantProfileId String
  name               String
  level              String?
  yearsOfExperience  Int?

  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId])
  @@index([name])
}

model Experience {
  id                 String           @id @default(uuid())
  applicantProfileId String
  company            String
  title              String
  location           String?
  startDate          String
  endDate            String?
  current            Boolean          @default(false)
  description        String?

  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId])
}

model Education {
  id                 String           @id @default(uuid())
  applicantProfileId String
  institution        String
  degree             String
  fieldOfStudy       String?
  startDate          String?
  endDate            String?
  current            Boolean          @default(false)

  applicantProfile   ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId])
}

model Job {
  id               String          @id @default(uuid())
  companyId        String
  recruiterId      String
  title            String
  description      String
  requirements     String
  responsibilities String
  skills           String
  location         String
  employmentType   EmploymentType  @default(FULL_TIME)
  experienceLevel  ExperienceLevel @default(MID_LEVEL)
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String          @default("USD")
  deadline         DateTime?
  status           JobStatus       @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter        RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  applications     Application[]

  @@index([companyId])
  @@index([recruiterId])
  @@index([status])
  @@index([title])
  @@index([location])
}

model Application {
  id           String                   @id @default(uuid())
  jobId        String
  applicantId  String
  currentStage ApplicationStage         @default(APPLIED)
  coverLetter  String?
  notes        String?
  rating       Int?
  appliedAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  job          Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant    ApplicantProfile         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  stageHistory ApplicationStageHistory[]
  interviews   Interview[]

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([currentStage])
}

model ApplicationStageHistory {
  id            String           @id @default(uuid())
  applicationId String
  previousStage ApplicationStage?
  newStage      ApplicationStage
  changedById   String
  reason        String?
  changedAt     DateTime         @default(now())

  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User             @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([changedById])
}

model Interview {
  id               String          @id @default(uuid())
  applicationId    String
  scheduledById    String
  interviewerName  String
  interviewerEmail String
  date             String
  startTime        String
  endTime          String
  interviewType    InterviewType
  status           InterviewStatus @default(SCHEDULED)
  meetingLink      String?
  location         String?
  notes            String?
  feedback         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  application      Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledBy      User            @relation(fields: [scheduledById], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledById])
  @@index([date])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  String?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
